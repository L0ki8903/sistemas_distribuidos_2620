# Copia este archivo a .env y ajusta los valores si lo necesitas.
# Todos tienen valor por defecto en docker-compose.yml, así que .env puede quedar vacío.

# Puerto del HOST donde se publica el gateway (local: http://localhost:8080).
# En Coolify se usa el puerto interno 80 del servicio "gateway".
GATEWAY_PORT=8080

# Credenciales de PostgreSQL (iguales en db-primary y db-replica).
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=orders_db

# Arrancar un nodo ya "caído" (Chaos Engineering desde el inicio).
NODE1_SIMULATE_CRASH=false
NODE2_SIMULATE_CRASH=false
