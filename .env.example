# Copia este archivo a .env y ajusta los valores si lo necesitas.
# Todos tienen valor por defecto en docker-compose.yml, así que .env puede quedar vacío.

# Puerto del HOST donde se publica el gateway (local: http://localhost:8080).
# En Coolify se usa el puerto interno 80 del servicio "gateway".
GATEWAY_PORT=8080

# Credenciales de PostgreSQL (iguales en db-primary y db-replica).
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=orders_db

# Arrancar un nodo ya "caído" (Chaos Engineering desde el inicio).
NODE1_SIMULATE_CRASH=false
NODE2_SIMULATE_CRASH=false

# ---------------------------------------------------------------- autenticación
# Secreto para firmar los JWT. DEBE ser largo, aleatorio y el MISMO en ambos nodos.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_MINUTES=480

# Administrador inicial (se crea al arrancar si no existe). Si ADMIN_PASSWORD queda vacío se genera
# una contraseña aleatoria y se imprime UNA vez en los logs:  docker compose logs | grep "ADMIN inicial"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin12345

# Permitir que cualquiera cree una cuenta de cliente desde la pantalla de inicio.
ALLOW_REGISTRATION=true
